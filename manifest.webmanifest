{
 "name": "Geländetaufe",
 "short_name": "Geländetaufe",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#d9dde2",
 "theme_color": "#1e3a5f",
 "lang": "de",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./share",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "file",
     "accept": [
      "application/json",
      ".json",
      "text/plain",
      "application/octet-stream",
      "*/*"
     ]
    }
   ]
  }
 },
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/json": [
     ".json"
    ],
    "text/plain": [
     ".txt"
    ]
   }
  }
 ]
}